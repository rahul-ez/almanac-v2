# Local disposable demo database only. Replace before any deployment.
POSTGRES_PASSWORD=almanac_local_demo
DATABASE_URL=postgresql+psycopg://almanac:almanac_local_demo@db:5432/almanac_demo
CAMPUS_TIMEZONE=Asia/Kolkata
APP_ENV=development
NLP_MODE=baseline

# Exact development origins; JSON array, no wildcard or trailing slash.
ALLOWED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000","http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
PREAUTH_TTL_SECONDS=900
LOGIN_LIMIT_PER_MINUTE=10
CSRF_LIMIT_PER_MINUTE=30

# NLP now-window and horizon; structured availability retains its 30-day maximum.
NOW_INTERVAL_MINUTES=30
NLP_HORIZON_DAYS=30
