        "building_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Building Id"
        },
        "capacity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capacity"
        },
        "department_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Department Id"
        },
        "eligible_only": {
          "default": false,
          "title": "Eligible Only",
          "type": "boolean"
        },
        "event_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Event Type"
        },
        "facility_ids": {
          "items": {
            "type": "string"
          },
          "title": "Facility Ids",
          "type": "array"
        },
        "faculty_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Faculty Id"
        },
        "interval": {
          "anyOf": [
            {
              "$ref": "#/$defs/Interval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "max_cost_minor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Cost Minor"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        },
        "student_year": {
          "anyOf": [
            {
              "maximum": 8,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Student Year"
        },
        "topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        }
      },
      "title": "Filters",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "Interval",
      "type": "object"
    },
    "Meaning": {
      "additionalProperties": false,
      "properties": {
        "filters": {
          "$ref": "#/$defs/Filters"
        },
        "intent": {
          "enum": [
            "find_events",
            "find_available_rooms",
            "find_faculty_office_hours"
          ],
          "title": "Intent",
          "type": "string"
        }
      },
      "required": [
        "intent",
        "filters"
      ],
      "title": "Meaning",
      "type": "object"
    },
    "OfficeHoursQuery": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "maxLength": 1024,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        },
        "from_at": {
          "format": "date-time",
          "title": "From At",
          "type": "string"
        },
        "limit": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "to_at": {
          "format": "date-time",
          "title": "To At",
          "type": "string"
        }
      },
      "required": [
        "from_at",
        "to_at"
      ],
      "title": "OfficeHoursQuery",
      "type": "object"
    },
    "Option": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Option",
      "type": "object"
    },
    "RoomExecution": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "room",
          "default": "room",
          "title": "Kind",
          "type": "string"
        },
        "query": {
          "$ref": "#/$defs/AvailabilityQuery"
        },
        "room_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Room Id"
        }
      },
      "required": [
        "query"
      ],
      "title": "RoomExecution",
      "type": "object"
    }
