  "additionalProperties": false,
  "properties": {
    "ambiguities": {
      "items": {
        "$ref": "#/$defs/Ambiguity"
      },
      "title": "Ambiguities",
      "type": "array"
    },
    "applied_context": {
      "items": {
        "$ref": "#/$defs/ContextValue"
      },
      "title": "Applied Context",
      "type": "array"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/ExtractedEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "execution": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "event": "#/$defs/EventExecution",
              "office_hours": "#/$defs/FacultyExecution",
              "room": "#/$defs/RoomExecution"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/EventExecution"
            },
            {
              "$ref": "#/$defs/RoomExecution"
            },
            {
              "$ref": "#/$defs/FacultyExecution"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "title": "Execution"
    },
    "intent": {
      "anyOf": [
        {
          "enum": [
            "find_events",
            "find_available_rooms",
            "find_faculty_office_hours"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Intent"
    },
    "intent_confidence": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Intent Confidence"
    },
    "intent_source": {
      "default": "rules",
      "enum": [
        "rules",
        "model"
      ],
      "title": "Intent Source",
      "type": "string"
    },
    "interpreter_version": {
      "default": "campus-rules-v1",
      "title": "Interpreter Version",
      "type": "string"
    },
    "meaning": {
      "anyOf": [
        {
          "$ref": "#/$defs/Meaning"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "status": {
      "enum": [
        "ready",
        "clarification_required",
        "unsupported"
      ],
      "title": "Status",
      "type": "string"
    },
    "unsupported_constraints": {
      "items": {
        "type": "string"
      },
      "title": "Unsupported Constraints",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "status",
    "intent",
    "meaning",
    "execution",
    "entities",
    "applied_context",
    "message"
  ],
  "title": "Interpretation",
  "type": "object"
}
