        "end": {
          "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$",
          "title": "End",
          "type": "string"
        },
        "start": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Start",
          "type": "string"
        },
        "weekday": {
          "maximum": 6,
          "minimum": 0,
          "title": "Weekday",
          "type": "integer"
        }
      },
      "required": [
        "weekday",
        "start",
        "end"
      ],
      "title": "OpeningHour",
      "type": "object"
    }
  },
